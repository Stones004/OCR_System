# Copy this file to .env before running `docker compose up`.
# docker-compose.yml's env_file directive fails to start any service
# if .env doesn't exist, even if you don't need to override anything --
# so this file just needs to exist; nothing below is required.
#
# Native (venv-only) runs don't need this file at all -- config.yaml's
# defaults (redis://localhost:6379/0, observability disabled) work there.
# app/core/config/config.docker.yaml (baked into the image at build
# time -- see its header comment) already points at redis://redis:6379/0,
# so BROKER_URL below is only needed if you want to override that.
# BROKER_URL=redis://redis:6379/0

# Optional: only used if observability.enabled is set to true (in
# app/core/config/config.docker.yaml for this Compose stack).
# OPENOBSERVE_ENDPOINT=http://openobserve:5080/api/default/v1/traces
# OPENOBSERVE_USERNAME=admin@example.com
# OPENOBSERVE_PASSWORD=Admin@123
# OPENOBSERVE_SERVICE_NAME=ocr-answer-scanner
#
# If you override OPENOBSERVE_PASSWORD, it must match the openobserve
# service's ZO_ROOT_USER_PASSWORD in docker-compose.yml -- OpenObserve
# authenticates trace ingestion as that same root user, and rejects
# passwords that don't have at least one lowercase, one uppercase, one
# digit, and one special character.
